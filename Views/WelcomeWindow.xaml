<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="JustBedwars.Views.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JustBedwars.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:dev="using:DevWinUI"
    mc:Ignorable="d"
    Title="WelcomeWindow">

    <Window.SystemBackdrop>
        <dev:TransparentBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <SystemBackdropElement CornerRadius="16" Loaded="SetCenter" x:Name="BackdropElement">
            <SystemBackdropElement.SystemBackdrop>
                <MicaBackdrop/>
            </SystemBackdropElement.SystemBackdrop>

            <animations:Implicit.ShowAnimations>
                <animations:ScaleAnimation From="0.8" To="1" Duration="0:0:1.3" EasingMode="EaseOut"/>
                <animations:OpacityAnimation From="0" To="1" Duration="0:0:0.6"/>
            </animations:Implicit.ShowAnimations>

            <animations:Implicit.HideAnimations>
                <animations:ScaleAnimation From="1" To="0.8" Duration="0:0:0.3" Delay="0:0:0.2" EasingMode="EaseIn"/>
                <animations:OpacityAnimation From="1" To="0" Duration="0:0:0.3" Delay="0:0:0.2" EasingMode="EaseIn"/>
            </animations:Implicit.HideAnimations>
        </SystemBackdropElement>

        <Border>
            <dev:EdgeLighting CornerRadius="16"
                              StrokeThickness="4"
                              MidColor="#0260CC"
                              HighlightColor="#0590FF"
                              FadeColor="#2050AA"
                              BorderStrokeColor="#405080"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>
            <animations:Implicit.ShowAnimations>
                <animations:OpacityAnimation Duration="0:0:5" From="0" To="0" Delay="0:0:1.3">
                    <animations:ScalarKeyFrame Key="0.2" Value="1"/>
                    <animations:ScalarKeyFrame Key="0.75" Value="1"/>
                </animations:OpacityAnimation>
            </animations:Implicit.ShowAnimations>
        </Border>

        <Grid CornerRadius="16" x:Name="ContentGrid" Loaded="SetCenter" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <animations:Implicit.ShowAnimations>
                <animations:OpacityAnimation From="0" To="1" Duration="0:0:0.3" Delay="0:0:1.3"/>
            </animations:Implicit.ShowAnimations>

            <animations:Implicit.HideAnimations>
                <animations:OpacityAnimation From="1" To="0" Duration="0:0:0.4" EasingMode="EaseIn"/>
            </animations:Implicit.HideAnimations>

            <ScrollView Loaded="SetCenter" x:Name="ScrollView">
                <animations:Implicit.HideAnimations>
                    <animations:ScaleAnimation From="1" To="0.7" Duration="0:0:0.4" EasingMode="EaseIn"/>
                </animations:Implicit.HideAnimations>
                <StackPanel Padding="16">
                    <StackPanel Orientation="Horizontal" Padding="16" Spacing="8">
                        <Image Source="ms-appx:///Assets/Wide310x150Logo.scale-200.png"
                               Width="155"
                               Height="75"
                               Loaded="SetCenter">
                            <animations:Implicit.ShowAnimations>
                                <animations:ScaleAnimation From="0.9" To="1" Duration="0:0:0.7" Delay="0:0:1.2"/>
                                <animations:OpacityAnimation From="0" To="1" Duration="0:0:0.7" Delay="0:0:1.2"/>
                            </animations:Implicit.ShowAnimations>
                        </Image>
                        <TextBlock Text="Welcome to JustBedwars!"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold">
                            <animations:Implicit.ShowAnimations>
                                <animations:OpacityAnimation From="0" To="1" Duration="0:0:0.7" Delay="0:0:1.6"/>
                            </animations:Implicit.ShowAnimations>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="Let's configure a few settings before starting"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Padding="4">
                        <animations:Implicit.ShowAnimations>
                            <animations:OpacityAnimation From="0" To="1" Duration="0:0:0.7" Delay="0:0:2"/>
                            <animations:TranslationAnimation From="0,20,0" To="0" Duration="0:0:0.7" Delay="0:0:2"/>
                        </animations:Implicit.ShowAnimations>
                    </TextBlock>
                    <TextBlock Text="You can always change these later"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Padding="4">
                        <animations:Implicit.ShowAnimations>
                            <animations:OpacityAnimation From="0" To="1" Duration="0:0:0.7" Delay="0:0:2.1"/>
                            <animations:TranslationAnimation From="0,20,0" To="0" Duration="0:0:0.7" Delay="0:0:2.1"/>
                        </animations:Implicit.ShowAnimations>
                    </TextBlock>

                    <StackPanel MaxWidth="800"
                                Spacing="4"
                                Padding="0,12,0,12">
                        <animations:Implicit.ShowAnimations>
                            <animations:OpacityAnimation From="0" To="1" Duration="0:0:0.7" Delay="0:0:2.5"/>
                            <animations:TranslationAnimation From="0,50,0" To="0" Duration="0:0:0.7" Delay="0:0:2.5"/>
                        </animations:Implicit.ShowAnimations>

                        <controls:SettingsCard Header="Where's your log file?"
                                               Description="If you use the vanilla launcher just keep the default, else pick your .minecraft/logs/latest.log file"
                                               x:Name="LogCard">
                            <controls:SettingsCard.Resources>
                                <x:Double x:Key="SettingsCardWrapThreshold">900</x:Double>
                            </controls:SettingsCard.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="LogFilePathTextBox" MaxWidth="726" CornerRadius="4,0,0,4"/>
                                    <Button x:Name="SelectLogFileButton"
                                        Click="SelectLogFileButton_Click"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        CornerRadius="0,4,4,0"
                                        Height="32">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Send usage statistics?"
                                               Description="Send fully anonymous usage data and crash reports to help improve the app. You can see exactly what gets sent in the settings later.">
                            <ToggleSwitch x:Name="UsageStatisticsSwitch"/>
                        </controls:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </ScrollView>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Grid.Row="1">
                <animations:Implicit.ShowAnimations>
                    <animations:TranslationAnimation From="0,64,0" To="0" Duration="0:0:1.2" Delay="0:0:3"/>
                </animations:Implicit.ShowAnimations>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="16">
                    <dev:BubbleButton x:Name="FinishButton"
                                      Background="{ThemeResource AccentFillColorDefaultBrush}"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                      Content="Finish">
                        <dev:BubbleButton.Resources>
                            <!-- Extra stuff because BubbleButton breaks with AccentButtonStyle -->
                            <StaticResource x:Key="ButtonBackground" ResourceKey="AccentFillColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="AccentFillColorDisabledBrush" />
                            <StaticResource x:Key="ButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextOnAccentFillColorDisabled" />
                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="AccentControlElevationBorderBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AccentControlElevationBorderBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="ControlFillColorTransparentBrush" />
                        </dev:BubbleButton.Resources>
                    </dev:BubbleButton>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
