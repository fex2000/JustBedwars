<?xml version="1.0" encoding="utf-8"?>

<Page x:Class="JustBedwars.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollView HorizontalAlignment="Stretch"
                ZoomMode="Disabled">
        <StackPanel Orientation="Vertical"
                    Padding="50"
                    Spacing="4"
                    MaxWidth="1100"
                    VerticalAlignment="Top">
            <StackPanel.ChildrenTransitions>
                <RepositionThemeTransition IsStaggeringEnabled="False"/>
            </StackPanel.ChildrenTransitions>
            <TextBlock Text="Settings"
                       FontWeight="SemiBold"
                       FontSize="30"
                       Margin="0"/>

            <!-- General Settings -->
            <TextBlock Text="Player List"
                       FontSize="14"
                       Margin="6, 36, 6, 6"
                       FontWeight="Medium"/>

            <!-- Sorting -->
            <toolkit:SettingsExpander Header="Player Sorting"
                                      Description="The order that players appear in">
                <ComboBox x:Name="SortingComboBox"
                          PlaceholderText="Select Sorting"
                          Width="200"
                          SelectionChanged="SortingComboBox_SelectionChanged">
                    <x:String> JustBedwars Score </x:String>
                    <x:String> Skill Index </x:String>
                    <x:String> Stars </x:String>
                    <x:String> FKDR </x:String>
                    <x:String> WLR </x:String>
                </ComboBox>
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE8CB;"/>
                </toolkit:SettingsExpander.HeaderIcon>

                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="JustBedwars Score"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="A balanced way of telling a players Skill, using almost every stat"/>
                            <TextBlock
                                Text="Calculation: Level &#x22C5; FKDR^2 &#x22C5; WLR^1.2 &#x22C5; BBLR^1.1 &#x22C5; (1 + Finals / 1000 + Kills / 2000 + Beds / 500 + Wins / 1000)"/>
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Skill Index"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock
                                Text="The simpler way of scoring players used in most other Bedwars skill trackers"/>
                            <TextBlock Text="Calculation: Level &#x22C5; FKDR^2"/>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <!-- Log -->
            <toolkit:SettingsCard Header="Log Location"
                                  Description="Set to your .minecraft/logs/latest.log location to use">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <TextBox x:Name="LogFilePathTextBox"
                             IsReadOnly="True"
                             Width="200"/>
                    <Button x:Name="SelectLogFileButton"
                            Content="Select"
                            Click="SelectLogFileButton_Click"/>
                </StackPanel>
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE8E5;"/>
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>


            <!-- More Settings -->
            <TextBlock Text="More"
                       FontSize="14"
                       Margin="6, 24, 6, 6"
                       FontWeight="Medium"/>

            <!-- Advanced Settings -->
            <toolkit:SettingsExpander Header="JustBedwars">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind Version}"/>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard HorizontalContentAlignment="Left"
                                          ContentAlignment="Left">
                        <StackPanel Margin="-12,0,0,0"
                                    Orientation="Vertical">
                            <TextBlock Text="About"
                                       Margin="12, 6"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <HyperlinkButton Content="GitHub Repository"
                                             NavigateUri="https://github.com/fex2000/JustBedwars"/>
                            <HyperlinkButton Content="Download Page"
                                             NavigateUri="https://fex2000.github.io/JustBedwars/"/>
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard HorizontalContentAlignment="Left"
                                          ContentAlignment="Left">
                        <StackPanel Margin="-12,0,0,0"
                                    Orientation="Vertical">
                            <TextBlock Text="Powered by"
                                       Margin="12, 6"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <HyperlinkButton Content="Hypixel API"
                                             NavigateUri="https://api.hypixel.net/"/>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE946;"/>
                </toolkit:SettingsExpander.HeaderIcon>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander Header="Usage Statistics"
                                      Description="Send usage info for diagnostics">
                <ToggleSwitch x:Name="UsageToggleSwitch"
                              Toggled="UsageToggleSwitch_OnToggled"/>
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;"/>
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard HorizontalContentAlignment="Left"
                                          ContentAlignment="Left">
                        <StackPanel Margin="12,0,0,0"
                                    Orientation="Vertical">
                            <TextBlock Text="What data is collected?"
                                       Margin="0, 6"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock> - Windows Version </TextBlock>
                            <TextBlock> - App Version &amp; Build Type </TextBlock>
                            <TextBlock> - Timestamp &amp; Session Duration </TextBlock>
                            <TextBlock> - Source Country/City (From IP) </TextBlock>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="8,0,0,0">
                                - The IP address is immediately deleted after deriving the country and is never stored
                            </TextBlock>
                            <TextBlock> - Sent Events </TextBlock>
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard HorizontalContentAlignment="Left"
                                          ContentAlignment="Left">
                        <StackPanel Margin="12,0,0,0"
                                    Orientation="Vertical">
                            <TextBlock Text="Which events trigger a message?"
                                       Margin="0, 6"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock> - App launch &amp; close </TextBlock>
                            <TextBlock> - An unhandled exception occurs </TextBlock>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="10,0,0,0"
                                       FontSize="11">
                                Includes the exception type and basic crash details to help fix it
                            </TextBlock>
                            <TextBlock> - Setup is Finished </TextBlock>
                            <TextBlock> - Guild is Searched </TextBlock>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="10,0,0,0"
                                       FontSize="11">
                                And the guild name
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="10,0,0,0"
                                       FontSize="11">
                                This also is used for improving the autocomplete database for guilds
                            </TextBlock>
                            <TextBlock> - Update is Skipped or Installed </TextBlock>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="10,0,0,0"
                                       FontSize="11">
                                Includes the version numbers you are updating from and to
                            </TextBlock>
                            <TextBlock> - A player is looked up </TextBlock>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="10,0,0,0"
                                       FontSize="11">
                                And the username of the player you're looking for and from where in the app it was searched
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="10,0,0,0"
                                       FontSize="11">
                                This also is used for improving the autocomplete database for players
                            </TextBlock>
                            <TextBlock> - Leaderboards are opened </TextBlock>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="10,0,0,0"
                                       FontSize="11">
                                And what tab you're on
                            </TextBlock>
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard HorizontalContentAlignment="Left"
                                          ContentAlignment="Left">
                        <StackPanel Margin="12,0,0,0"
                                    Orientation="Vertical">
                            <TextBlock Text="How is this data used?"
                                       Margin="0, 6"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock> Events: To see which areas need improvement </TextBlock>
                            <TextBlock> OS Version: To see what the oldest Windows Versions that need to be supported are </TextBlock>
                            <TextBlock> App Version: To see how many people are too lazy to update </TextBlock>
                            <TextBlock> Session Duration, Timestamp, Events: To see how actively the app is used </TextBlock>
                            <TextBlock> Source Country: To see which languages would be good to localize to </TextBlock>
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard HorizontalContentAlignment="Left"
                                          ContentAlignment="Left">
                        <StackPanel Margin="12,0,0,0"
                                    Orientation="Vertical">
                            <TextBlock Text="Good to know"
                                       Margin="0, 6"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock> - There is no way to track you across sessions, nothing is permanent </TextBlock>
                            <TextBlock> - Every time you launch the app, you get a session ID that is used to get a timeline of all events sent </TextBlock>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander Header="Developer Settings"
                                      Description="Additional Setting primarily made for Development">
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="Debug Utilities">
                        <Button Content="Open Logs"
                                Click="OpenDebugWindow_Click"
                                Margin="0,10,0,0"/>
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE756;"/>
                        </toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Hypixel API Key"
                                          Description="For development, not recommended for regular users, can be bannable.">
                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                     PasswordChanged="ApiKeyPasswordBox_PasswordChanged"
                                     IsPasswordRevealButtonEnabled="True"/>
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE8D7;"/>
                        </toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Return to welcome screen"
                                          Description="Open the welcome screen again">
                        <Button Content="Open"
                                Click="ResetWelcomeStateButton_OnClick"/>
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE81C;"/>
                        </toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE9F5;"/>
                </toolkit:SettingsExpander.HeaderIcon>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander Header="Save Logs"
                                      Description="Save the latest application log, can be helpful for catching application issues.">
                <StackPanel Orientation="Horizontal"
                            Spacing="16">
                    <ToggleSwitch x:Name="SaveDebugLogsToggle"
                                  Toggled="SaveDebugLogsToggle_Toggled"/>
                    <Button x:Name="OpenLogFolderButton"
                            Content="Open Folder"
                            Click="OpenLogFolderButton_Click"/>
                </StackPanel>
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE7C3;"/>
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="Save Log History"
                                          Description="Save a history of logs.">
                        <ToggleSwitch x:Name="EnableLogHistoryToggle"
                                      Toggled="EnableLogHistoryToggle_Toggled"/>
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE81C;"/>
                        </toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Enable Minecraft Logging"
                                          Description="Toggle wether enable the Minecraft Chat Logs should be included.">
                        <ToggleSwitch x:Name="EnableLogReaderLoggingToggle"
                                      Toggled="EnableLogReaderLoggingToggle_Toggled"/>
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE756;"/>
                        </toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollView>
</Page>